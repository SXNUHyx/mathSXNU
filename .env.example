# Example only. Run python3 scripts/configure-deployment.py to create your own .env.
CLASSROOM_DOMAIN=classroom.example.com
DJANGO_SECRET_KEY=replace-with-a-generated-secret-do-not-use-this-example
# HTTPS is the default. Use scripts/set-access-mode.py for an explicit HTTP trial.
CLASSROOM_SCHEME=https
CLASSROOM_ALLOW_INSECURE_HTTP=0
# Optional: licensed MathType Web service base URI (not a secret/license key).
# Leave blank to use the free local visual formula editor.
MATHTYPE_SERVICE_URI=
MATHTYPE_SERVICE_SERVER=java
